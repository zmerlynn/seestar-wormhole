#!/bin/sh
# main changes only through a PR merged on GitHub; refuse any push that would update or delete it.
# Enable with: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = refs/heads/main ]; then
		echo "pre-push: refusing to push to main on $1; open a PR instead" >&2
		exit 1
	fi
done
exit 0
